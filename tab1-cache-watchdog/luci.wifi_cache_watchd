#!/bin/sh
# rpcd plugin backing the LuCI "Wi-Fi Cache Watchdog" status page.
# Install as /usr/libexec/rpcd/luci.wifi_cache_watchd (chmod +x).
# Registers ubus object "luci.wifi_cache_watchd" with methods:
#   status()          -> read-only counters + service state + current mode
#   log()             -> tail of this tool's syslog entries
#   action({name})    -> start|stop|enable|disable the service
#   set_mode({mode})  -> persist cleanup scope: wifi | lan | both
#   clients()         -> full list of currently known Wi-Fi + LAN clients

. /usr/share/libubox/jshn.sh

INIT=/etc/init.d/wifi_cache_watchd
TAG=wifi_cache_watchd
LEASEFILE=/tmp/dhcp.leases
LOGTMP=/tmp/.wcw_rpcd_logtmp
MODE_FILE=/etc/wifi_cache_watchd.mode
CONNECTED_DIR=/tmp/.wcw_connected
CLIENTS_RAW=/tmp/.wcw_clients_raw
RESULT_FILE=/tmp/.wcw_last_result

is_running() {
    pgrep -f wifi_cache_watchd.sh >/dev/null 2>&1
}

is_enabled() {
    ls /etc/rc.d/S??wifi_cache_watchd >/dev/null 2>&1
}

current_mode() {
    M=$(cat "$MODE_FILE" 2>/dev/null)
    case "$M" in
        wifi|lan|both) echo "$M" ;;
        *) echo wifi ;;
    esac
}

do_status() {
    CT_COUNT=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
    CT_MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 0)
    ARP_COUNT=$(ip neigh show 2>/dev/null | wc -l)
    DHCP_COUNT=0
    [ -f "$LEASEFILE" ] && DHCP_COUNT=$(wc -l < "$LEASEFILE")
    DNS_CACHE=$(uci get dhcp.@dnsmasq[0].cachesize 2>/dev/null || echo 150)
    LAST_EVENT=$(logread -e "$TAG" 2>/dev/null | tail -n 1)
    HAS_CONNTRACK=0; command -v conntrack >/dev/null 2>&1 && HAS_CONNTRACK=1
    HAS_BRIDGE=0; command -v bridge >/dev/null 2>&1 && HAS_BRIDGE=1

    RUNNING=0; is_running && RUNNING=1
    ENABLED=0; is_enabled && ENABLED=1

    LR_TIME=0; LR_RESULT=""; LR_REASON=""; LR_IFACE=""; LR_MAC=""
    if [ -f "$RESULT_FILE" ]; then
        _tab=$(printf '\t')
        IFS="$_tab" read -r LR_TIME LR_RESULT LR_REASON LR_IFACE LR_MAC < "$RESULT_FILE"
    fi

    json_init
    json_add_boolean running "$RUNNING"
    json_add_boolean enabled "$ENABLED"
    json_add_string mode "$(current_mode)"
    json_add_boolean has_conntrack_tools "$HAS_CONNTRACK"
    json_add_boolean has_bridge_tool "$HAS_BRIDGE"
    json_add_int conntrack_count "$CT_COUNT"
    json_add_int conntrack_max "$CT_MAX"
    json_add_int arp_count "$ARP_COUNT"
    json_add_int dhcp_leases "$DHCP_COUNT"
    json_add_string dns_cache_size "$DNS_CACHE"
    json_add_string last_event "$LAST_EVENT"
    json_add_int last_result_time "${LR_TIME:-0}"
    json_add_string last_result "${LR_RESULT:-}"
    json_add_string last_result_reason "${LR_REASON:-}"
    json_add_string last_result_iface "${LR_IFACE:-}"
    json_add_string last_result_mac "${LR_MAC:-}"
    json_dump
}

do_log() {
    # avoid a `cmd | while read` subshell (jshn state wouldn't survive it)
    logread -e "$TAG" 2>/dev/null | tail -n 200 > "$LOGTMP"
    json_init
    json_add_array lines
    while IFS= read -r L; do
        json_add_string "" "$L"
    done < "$LOGTMP"
    json_close_array
    json_dump
    rm -f "$LOGTMP"
}

do_action() {
    read -r INPUT
    NAME=""
    if command -v jsonfilter >/dev/null 2>&1; then
        NAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
    fi
    [ -n "$NAME" ] || NAME=$(echo "$INPUT" | sed -n 's/.*"name" *: *"\([A-Za-z]*\)".*/\1/p')

    OK=0
    case "$NAME" in
        start|stop|enable|disable)
            "$INIT" "$NAME" >/dev/null 2>&1 && OK=1
            ;;
    esac
    json_init
    json_add_boolean ok "$OK"
    json_dump
}

# Classify a MAC as "wifi" or "lan" by the physical bridge port it's seen on
# (bridge fdb), same logic as clear_net_cache.sh's classify_mac.
classify_mac() {
    _mac=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
    if ! command -v bridge >/dev/null 2>&1; then
        echo unknown
        return
    fi
    _dev=$(bridge fdb show 2>/dev/null | awk -v m="$_mac" 'tolower($1)==m && $2=="dev" {print $3; exit}')
    [ -n "$_dev" ] || { echo unknown; return; }
    for _w in $WIFI_IFACES; do
        [ "$_dev" = "$_w" ] && { echo wifi; return; }
    done
    echo lan
}

# Appends args to a file as one record per line, separated by CLIENTS_SEP.
# Uses a plain "|" rather than a tab: POSIX read/IFS treats tab as "IFS
# whitespace" and collapses consecutive delimiters, which silently eats
# empty fields (e.g. a LAN row's empty iface/ssid columns) and misaligns
# every field after them. A printable non-whitespace separator avoids that
# entirely -- also safer than hand-counting %s placeholders in a long
# printf format string.
CLIENTS_SEP='|'
join_tab_to() {
    _dest="$1"; shift
    _first=1
    for _v in "$@"; do
        if [ "$_first" = 1 ]; then
            printf '%s' "$_v"
            _first=0
        else
            printf '%s%s' "$CLIENTS_SEP" "$_v"
        fi
    done >> "$_dest"
    printf '\n' >> "$_dest"
}

# Formats a PHY rate (kbit/s, from iwinfo) plus its MCS/channel-width/guard
# interval/spatial-stream count into one human string, e.g.
# "866.7 Mbit/s (MCS9, 40MHz, SGI, 2ss)". All-passive: these are values the
# driver already measured on frames the client itself sent/received, no
# extra query is made of the device.
phy_str() {
    _rate="$1"; _mcs="$2"; _w40="$3"; _sgi="$4"; _nss="$5"
    if [ -z "$_rate" ] || [ "$_rate" = "0" ]; then
        echo "-"
        return
    fi
    _mbit=$(awk -v r="$_rate" 'BEGIN{printf "%.1f", r/1000}' 2>/dev/null)
    [ -n "$_mbit" ] || _mbit="?"
    _extra=""
    if [ -n "$_mcs" ] && [ "$_mcs" != "-1" ]; then
        _extra="MCS$_mcs"
    fi
    case "$_w40" in
        1|true) _extra="${_extra:+$_extra, }40MHz" ;;
    esac
    case "$_sgi" in
        1|true) _extra="${_extra:+$_extra, }SGI" ;;
    esac
    if [ -n "$_nss" ] && [ "$_nss" != "0" ]; then
        _extra="${_extra:+$_extra, }${_nss}ss"
    fi
    if [ -n "$_extra" ]; then
        echo "$_mbit Mbit/s ($_extra)"
    else
        echo "$_mbit Mbit/s"
    fi
}

do_clients() {
    : > "$CLIENTS_RAW"
    WIFI_IFACES=$(ubus list 2>/dev/null | sed -n 's/^hostapd\.//p')
    SEEN_MACS=""

    for IFACE in $WIFI_IFACES; do
        SSID=""; CHANNEL=0; FREQ=0; HTMODE=""
        SI_JSON=$(ubus call iwinfo info "{\"device\":\"$IFACE\"}" 2>/dev/null)
        if [ -n "$SI_JSON" ]; then
            json_load "$SI_JSON"
            json_get_var SSID ssid
            json_get_var CHANNEL channel
            json_get_var FREQ frequency
            json_get_var HTMODE htmode
        fi

        # Best-effort per-client 802.11 capability flags straight from
        # hostapd's own record of what the client advertised when it
        # associated -- not a new query to the device, just reading what
        # hostapd already has. May be unsupported on some builds (same
        # class of limitation as the ubus notify issue found earlier); if
        # the call fails, the fields below just stay empty.
        GC_JSON=$(ubus call "hostapd.$IFACE" get_clients 2>/dev/null)

        AL_JSON=$(ubus call iwinfo assoclist "{\"device\":\"$IFACE\"}" 2>/dev/null)
        [ -n "$AL_JSON" ] || continue

        json_load "$AL_JSON"
        json_select results 2>/dev/null
        json_get_keys KEYS

        for K in $KEYS; do
            json_load "$AL_JSON"
            json_select results
            json_select "$K"
            MAC=""; SIGNAL=0; NOISE=0; INACTIVE=0
            json_get_var MAC mac
            json_get_var SIGNAL signal
            json_get_var NOISE noise
            json_get_var INACTIVE inactive

            [ -n "$MAC" ] || continue
            NMAC=$(printf '%s' "$MAC" | tr 'A-Z' 'a-z')
            SEEN_MACS="$SEEN_MACS $NMAC"

            RXRATE=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].rx.rate" 2>/dev/null)
            TXRATE=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].tx.rate" 2>/dev/null)
            RXMCS=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].rx.mcs" 2>/dev/null)
            TXMCS=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].tx.mcs" 2>/dev/null)
            RX40=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].rx.40mhz" 2>/dev/null)
            TX40=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].tx.40mhz" 2>/dev/null)
            RXSGI=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].rx.short_gi" 2>/dev/null)
            TXSGI=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].tx.short_gi" 2>/dev/null)
            RXNSS=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].rx.nss" 2>/dev/null)
            TXNSS=$(printf '%s' "$AL_JSON" | jsonfilter -e "@.results[$K].tx.nss" 2>/dev/null)

            RXPHY=$(phy_str "$RXRATE" "$RXMCS" "$RX40" "$RXSGI" "$RXNSS")
            TXPHY=$(phy_str "$TXRATE" "$TXMCS" "$TX40" "$TXSGI" "$TXNSS")

            HT=""; VHT=""; HE=""; WMM=""; MFP=""
            if [ -n "$GC_JSON" ]; then
                HT=$(printf '%s' "$GC_JSON" | jsonfilter -e "@.clients[\"$MAC\"].ht" 2>/dev/null)
                VHT=$(printf '%s' "$GC_JSON" | jsonfilter -e "@.clients[\"$MAC\"].vht" 2>/dev/null)
                HE=$(printf '%s' "$GC_JSON" | jsonfilter -e "@.clients[\"$MAC\"].he" 2>/dev/null)
                WMM=$(printf '%s' "$GC_JSON" | jsonfilter -e "@.clients[\"$MAC\"].wmm" 2>/dev/null)
                MFP=$(printf '%s' "$GC_JSON" | jsonfilter -e "@.clients[\"$MAC\"].mfp" 2>/dev/null)
            fi

            SINCE_KEY=$(printf '%s' "$NMAC" | tr -dc 'a-z0-9')
            CSINCE=$(cat "$CONNECTED_DIR/$SINCE_KEY" 2>/dev/null || echo 0)

            join_tab_to "$CLIENTS_RAW" wifi "$NMAC" "$IFACE" "$SSID" "${SIGNAL:-0}" "${NOISE:-0}" \
                "$RXPHY" "$TXPHY" "${INACTIVE:-0}" "${CSINCE:-0}" "${CHANNEL:-0}" "${FREQ:-0}" \
                "$HTMODE" "$HT" "$VHT" "$HE" "$WMM" "$MFP"
        done
    done

    if [ -f "$LEASEFILE" ]; then
        while IFS=' ' read -r LEXP LMAC LIP LHOST LCID; do
            [ -n "$LMAC" ] || continue
            NMAC=$(printf '%s' "$LMAC" | tr 'A-Z' 'a-z')
            case " $SEEN_MACS " in
                *" $NMAC "*) continue ;;
            esac
            CLASS=$(classify_mac "$NMAC")
            [ "$CLASS" = "lan" ] || continue
            join_tab_to "$CLIENTS_RAW" lan "$NMAC" "" "" 0 0 "" "" 0 0 0 0 "" "" "" "" "" ""
        done < "$LEASEFILE"
    fi

    json_init
    json_add_array clients
    while IFS="$CLIENTS_SEP" read -r TYPE MAC IFACE SSID SIGNAL NOISE RXPHY TXPHY INACTIVE CSINCE CHANNEL FREQ HTMODE HT VHT HE WMM MFP; do
        [ -n "$MAC" ] || continue
        IP=""; HOST=""; LEXPIRES=0
        if [ -f "$LEASEFILE" ]; then
            LEASE_LINE=$(awk -v m="$MAC" 'tolower($2)==m {print; exit}' "$LEASEFILE")
            if [ -n "$LEASE_LINE" ]; then
                LEXPIRES=$(echo "$LEASE_LINE" | awk '{print $1}')
                IP=$(echo "$LEASE_LINE" | awk '{print $3}')
                HOST=$(echo "$LEASE_LINE" | awk '{print $4}')
                [ "$HOST" = "*" ] && HOST=""
            fi
        fi

        # Active outbound sessions for this client, from conntrack -- purely
        # reading the router's own NAT state table, no traffic sent to the
        # device to produce this.
        CONNCOUNT=0; CONNLIST=""
        if [ -n "$IP" ] && command -v conntrack >/dev/null 2>&1; then
            CONNCOUNT=$(conntrack -L -s "$IP" 2>/dev/null | wc -l)
            CONNLIST=$(conntrack -L -s "$IP" 2>/dev/null | head -n 5 | awk '{
                dst=""; dport="";
                for (i=1;i<=NF;i++) {
                    if ($i ~ /^dst=/) dst=substr($i,5);
                    if ($i ~ /^dport=/) dport=substr($i,7);
                }
                if (dst != "") { if (dport != "") print dst":"dport; else print dst }
            }' | tr '\n' ',' | sed 's/,$//')
        fi

        json_add_object ""
        json_add_string mac "$MAC"
        json_add_string type "$TYPE"
        json_add_string iface "$IFACE"
        json_add_string ssid "$SSID"
        json_add_string ip "$IP"
        json_add_string hostname "$HOST"
        json_add_int signal "${SIGNAL:-0}"
        json_add_int noise "${NOISE:-0}"
        json_add_string rx_phy "$RXPHY"
        json_add_string tx_phy "$TXPHY"
        json_add_int inactive_ms "${INACTIVE:-0}"
        json_add_int connected_since "${CSINCE:-0}"
        json_add_int lease_expires "${LEXPIRES:-0}"
        json_add_int channel "${CHANNEL:-0}"
        json_add_int frequency "${FREQ:-0}"
        json_add_string htmode "$HTMODE"
        json_add_string cap_ht "$HT"
        json_add_string cap_vht "$VHT"
        json_add_string cap_he "$HE"
        json_add_string cap_wmm "$WMM"
        json_add_string cap_mfp "$MFP"
        json_add_int conn_count "${CONNCOUNT:-0}"
        json_add_string conn_list "$CONNLIST"
        json_close_object
    done < "$CLIENTS_RAW"
    json_close_array
    json_dump
    rm -f "$CLIENTS_RAW"
}

do_set_mode() {
    read -r INPUT
    NEWMODE=""
    if command -v jsonfilter >/dev/null 2>&1; then
        NEWMODE=$(echo "$INPUT" | jsonfilter -e '@.mode' 2>/dev/null)
    fi
    [ -n "$NEWMODE" ] || NEWMODE=$(echo "$INPUT" | sed -n 's/.*"mode" *: *"\([a-z]*\)".*/\1/p')

    OK=0
    case "$NEWMODE" in
        wifi|lan|both)
            echo "$NEWMODE" > "$MODE_FILE" 2>/dev/null && OK=1
            logger -t "$TAG" "cleanup mode changed to '$NEWMODE' via LuCI"
            ;;
    esac
    json_init
    json_add_boolean ok "$OK"
    json_add_string mode "$(current_mode)"
    json_dump
}

case "$1" in
    list)
        echo '{ "status": {}, "log": {}, "action": { "name": "str" }, "set_mode": { "mode": "str" }, "clients": {} }'
        ;;
    call)
        case "$2" in
            status) do_status ;;
            log) do_log ;;
            action) do_action ;;
            set_mode) do_set_mode ;;
            clients) do_clients ;;
            *) echo '{}'; exit 1 ;;
        esac
        ;;
esac
