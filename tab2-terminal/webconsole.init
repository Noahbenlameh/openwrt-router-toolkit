#!/bin/sh /etc/rc.common
# Install as /etc/init.d/webconsole
#
# procd-managed ttyd instance: a real interactive shell served in the
# browser, embedded into the LuCI "Терминал" tab via an iframe.
#
# Refuses to start until /etc/webconsole.auth exists with "user:pass" --
# no hardcoded/default credential is ever shipped.

START=98
STOP=10

USE_PROCD=1

AUTH_FILE=/etc/webconsole.auth
BIND_IF=br-lan
PORT=7681

start_service() {
    if [ ! -s "$AUTH_FILE" ]; then
        logger -t webconsole "refusing to start: $AUTH_FILE is missing or empty. Create it first: printf 'root:YOUR_OWN_PASSWORD\n' > $AUTH_FILE && chmod 600 $AUTH_FILE"
        return 1
    fi
    CREDS=$(head -n1 "$AUTH_FILE")

    procd_open_instance
    procd_set_param command /usr/bin/ttyd -i "$BIND_IF" -p "$PORT" -c "$CREDS" -W /bin/ash -l
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
