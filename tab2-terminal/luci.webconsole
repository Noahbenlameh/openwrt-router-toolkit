#!/bin/sh
# rpcd plugin backing the LuCI "Терминал" page.
# Install as /usr/libexec/rpcd/luci.webconsole (chmod +x).
# Registers ubus object "luci.webconsole" with methods:
#   status()       -> running/enabled/auth-configured state + port
#   action({name}) -> start|stop|enable|disable the service

. /usr/share/libubox/jshn.sh

INIT=/etc/init.d/webconsole
AUTH_FILE=/etc/webconsole.auth
PORT=7681

is_running() {
    pgrep -f '/usr/bin/ttyd' >/dev/null 2>&1
}

is_enabled() {
    ls /etc/rc.d/S??webconsole >/dev/null 2>&1
}

has_auth() {
    [ -s "$AUTH_FILE" ]
}

do_status() {
    RUNNING=0; is_running && RUNNING=1
    ENABLED=0; is_enabled && ENABLED=1
    HASAUTH=0; has_auth && HASAUTH=1

    json_init
    json_add_boolean running "$RUNNING"
    json_add_boolean enabled "$ENABLED"
    json_add_boolean has_auth "$HASAUTH"
    json_add_int port "$PORT"
    json_dump
}

do_action() {
    read -r INPUT
    NAME=""
    if command -v jsonfilter >/dev/null 2>&1; then
        NAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
    fi
    [ -n "$NAME" ] || NAME=$(echo "$INPUT" | sed -n 's/.*"name" *: *"\([A-Za-z]*\)".*/\1/p')

    OK=0
    case "$NAME" in
        start|stop|enable|disable)
            "$INIT" "$NAME" >/dev/null 2>&1 && OK=1
            ;;
    esac
    json_init
    json_add_boolean ok "$OK"
    json_dump
}

case "$1" in
    list)
        echo '{ "status": {}, "action": { "name": "str" } }'
        ;;
    call)
        case "$2" in
            status) do_status ;;
            action) do_action ;;
            *) echo '{}'; exit 1 ;;
        esac
        ;;
esac
